{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "traffic-now-worker",
  "main": "src/index.js",
  "compatibility_date": "2026-09-30",
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "TRAFFIC_CACHE",
      "id": "0177091bb8fa45a8a5a23fb50230b84b"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
